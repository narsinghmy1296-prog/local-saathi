# Copy this file to `.env` (and never commit the real .env — see .gitignore)
# and fill in real values before running in anything beyond local dev.

# Long random string — used to sign JWT auth tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LOCAL_SAATHI_SECRET_KEY=change-this-to-something-random

# How long a login session stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dev default is a local SQLite file. In production point this at Postgres:
#   postgresql+psycopg2://user:password@host:5432/local_saathi
DATABASE_URL=sqlite:///./local_saathi.db

# Comma-separated list of allowed frontend origins. "*" (dev default) means
# "allow everything" — replace with your real Android/web app origins
# before deploying.
CORS_ALLOWED_ORIGINS=*
