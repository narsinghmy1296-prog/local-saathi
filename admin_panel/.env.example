# Copy this file to .env and set the real backend URL for your environment.
# Never commit the real .env file.

# Base URL of the Local Saathi FastAPI backend, WITHOUT a trailing slash
# and WITHOUT the /api/v1 suffix (the app adds that itself).
# Example (local dev):        http://127.0.0.1:8000
# Example (deployed backend): https://local-saathi-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
